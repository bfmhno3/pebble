+    use super::BumpAllocator;
+    use core::alloc::{GlobalAlloc, Layout};
+
+    #[test]
+    fn reset_frees_everything() {
+        let mut owned: BumpAllocator<64> = BumpAllocator::new();
+        // SAFETY: the layout is valid; the pointer is only checked for null.
+        assert!(!unsafe { owned.alloc(Layout::new::<u64>()) }.is_null());
